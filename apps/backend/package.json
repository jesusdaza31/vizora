{
  "name": "@vizora/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --watch --env-file=.env src/index.ts",
    "build": "swc src --out-dir dist",
    "start": "pnpm build && cross-env NODE_ENV=production node -r module-alias/register --env-file=.env dist/src/index.js"
  },
  "_moduleAliases": {
    "@": "./dist/src"
  },
  "dependencies": {
    "@vizora/config": "workspace:*",
    "@vizora/database": "workspace:*",
    "@vizora/types": "workspace:*",
    "express": "4.21.0",
    "module-alias": "2.2.3",
    "neverthrow": "8.2.0",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.8.0",
    "uuid": "11.0.0"
  },
  "devDependencies": {
    "@swc/cli": "0.5.0",
    "@swc/core": "1.10.0",
    "@types/express": "4.17.21",
    "@types/module-alias": "2.0.4",
    "@types/uuid": "10.0.0",
    "cross-env": "^10.1.0",
    "tsx": "4.19.0",
    "typescript": "6.0.3"
  }
}
